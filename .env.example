PORT=5500
HOST=127.0.0.1
PUBLIC_ORIGIN=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=customer_credit
DB_CONNECTION_LIMIT=10
DB_AUTO_CREATE=true
STORE_NAME=Main Store
DEFAULT_ENTERPRISE_CODE=main
DEFAULT_ENTERPRISE_USERNAME=owner
STORE_PASSWORD=store1234
STORE_PASSWORD_HASH=
SESSION_SECRET=change-this-to-a-long-random-secret
SESSION_HOURS=12
OWNER_PIN=2025
COOKIE_SECURE=false
MAX_LOGIN_ATTEMPTS=8
LOGIN_LOCK_MINUTES=10
MAX_SIGNUPS_PER_HOUR=5
SIGNUP_INVITE_DAYS=7
RESEND_API_KEY=
EMAIL_FROM=Nazi Credit <security@nazicredit.com>
PASSWORD_RESET_MINUTES=30
EMAIL_VERIFY_HOURS=24
BACKUP_ENABLED=false
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_FORCE_PATH_STYLE=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=35
# OpenAI is used only by the Node.js backend. Never put this key in browser JavaScript.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
AI_SUMMARY_CACHE_MINUTES=15
# Order-ready notifications. "log" writes development deliveries to the server console.
# Replace this with a registered adapter name when SMS, WhatsApp, or email is configured.
ORDER_NOTIFICATION_PROVIDER=log
# To enable real SMS, change the provider to twilio and set these securely.
# ORDER_NOTIFICATION_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-secret-token
# Use either a Messaging Service SID (recommended for A2P 10DLC) or a From number.
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+15551234567
